{
    "id": "nl.tijnschutte.translator",
    "name": "Translator",
    "description": "Shows each post translated into the language each user picks.",
    "homepage_url": "https://github.com/tijnschutte/mattermost-plugin-translator",
    "support_url": "https://github.com/tijnschutte/mattermost-plugin-translator/issues",
    "icon_path": "assets/icon.svg",
    "min_server_version": "10.12.0",
    "server": {
        "executables": {
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64",
            "darwin-amd64": "server/dist/plugin-darwin-amd64",
            "darwin-arm64": "server/dist/plugin-darwin-arm64",
            "windows-amd64": "server/dist/plugin-windows-amd64.exe"
        }
    },
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    },
    "settings_schema": {
        "header": "Pick a translation service. Azure AI Translator gives the best quality, and its free F0 tier covers 2,000,000 characters per month. LibreTranslate runs on your own server, so no text leaves it.",
        "footer": "",
        "settings": [
            {
                "key": "Service",
                "display_name": "Translation service:",
                "type": "dropdown",
                "default": "azure",
                "help_text": "The service that translates posts.",
                "options": [
                    {
                        "display_name": "Azure AI Translator",
                        "value": "azure"
                    },
                    {
                        "display_name": "LibreTranslate",
                        "value": "libretranslate"
                    }
                ]
            },
            {
                "key": "AzureKey",
                "display_name": "Azure key:",
                "type": "text",
                "secret": true,
                "help_text": "Key 1 or Key 2 of the Translator resource. Used only when the service is Azure AI Translator."
            },
            {
                "key": "AzureRegion",
                "display_name": "Azure region:",
                "type": "text",
                "help_text": "The region of the Translator resource, for example westeurope. Leave empty for a global resource.",
                "placeholder": "westeurope"
            },
            {
                "key": "AzureEndpoint",
                "display_name": "Azure endpoint:",
                "type": "text",
                "default": "https://api.cognitive.microsofttranslator.com",
                "help_text": "Change this only for a custom or sovereign-cloud endpoint. It must start with https://."
            },
            {
                "key": "LibreTranslateURL",
                "display_name": "LibreTranslate URL:",
                "type": "text",
                "help_text": "The address of the LibreTranslate server, for example http://libretranslate:5000. Used only when the service is LibreTranslate.",
                "placeholder": "http://libretranslate:5000"
            },
            {
                "key": "LibreTranslateAPIKey",
                "display_name": "LibreTranslate API key:",
                "type": "text",
                "secret": true,
                "help_text": "Only if the LibreTranslate server asks for a key. Servers you host yourself usually need none."
            }
        ]
    }
}
